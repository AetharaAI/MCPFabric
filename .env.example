# MCP Fabric Frontend Environment Configuration
#
# IMPORTANT:
# Only variables prefixed with VITE_ are exposed to browser code.
# Do NOT put private secrets here.

# Required for API Keys + Docs pages:
# Backend base URL hosting /admin/* and /docs endpoints.
VITE_FABRIC_API_BASE=https://fabric.perceptor.us

# Optional legacy/local-dev variables.
# Keep only if you still use mock-mode or older local API wiring.
# VITE_MCP_SERVER_URL=http://localhost:8080
# VITE_SSE_URL=http://localhost:8080/stream
# VITE_MOCK_DATA_ENABLED=false
