# MCP Fabric Environment Configuration

# Application
NODE_ENV=development
VITE_APP_NAME=MCP Fabric
VITE_APP_URL=http://localhost:5173

# MCP Server Configuration
VITE_MCP_SERVER_URL=http://localhost:8080
VITE_MCP_API_KEY=your-api-key-here

# SSE Stream Configuration
VITE_SSE_URL=http://localhost:8080/stream
VITE_SSE_RECONNECT_INTERVAL=3000

# Tenant Configuration
VITE_DEFAULT_TENANT=tenant-1
VITE_MULTI_TENANT_ENABLED=true

# Feature Flags
VITE_ENABLE_OBSERVATORY=true
VITE_ENABLE_CONSOLE=true
VITE_ENABLE_PLAYGROUND=true
VITE_ENABLE_SHREDDER=true

# Observability
VITE_RETENTION_DAYS=30
VITE_MAX_EVENTS=10000

# Development
VITE_MOCK_DATA_ENABLED=true
VITE_MOCK_SSE_INTERVAL=3000
